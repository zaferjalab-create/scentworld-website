<%
  // Server-rendered from the live catalogue (prices include any running promo).
  // models: active diffusers covering more than 500 sq ft, smallest first.
  // small:  the room-size units (up to 500 sq ft), mentioned once below the table.
  const money = n => '$' + Number(n || 0).toLocaleString('en-CA', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
  const hvacNames = models.filter(m => m._hvac).map(m => m.name.replace(/\s+(Commercial|Nano)?\s*Diffuser$/i, ''));
  const listNames = a => a.length <= 1 ? a.join('') : a.slice(0, -1).join(', ') + ' and ' + a[a.length - 1];
  const lo = models.length ? Math.min(...models.map(m => m.price || 0)) : 0;
  const hi = models.length ? Math.max(...models.map(m => m.price || 0)) : 0;
  const faq = [
    ['Which size do I need?',
     'Measure the floor area you want scented, then pick the model whose coverage includes that number. If you are between two sizes, call us and we will help you choose.'],
  ];
  if (hvacNames.length) faq.push(['Can it connect to my HVAC system?',
     `Yes. The ${listNames(hvacNames)} can connect to HVAC ducts, so one unit scents several rooms.`]);
  faq.push(
    ['What does it run on?',
     `Scent World fragrance oils. There are ${oilCount} scents to choose from, and auto-refill delivery is available so you don't run out.`],
    ['How fast is shipping?',
     `Orders ship from Halifax within 24–48 hours and arrive in 3–8 business days, tracked. Shipping is free over $${shipping && shipping.threshold != null ? shipping.threshold : 150} CAD anywhere in Canada.`],
    ['Can you create a signature scent for our brand?',
     'Yes. Tell us about your space and we will recommend a scent and a diffuser, or develop a custom signature scent for your business.']
  );
%><!DOCTYPE html>
