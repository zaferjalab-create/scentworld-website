  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Commercial Scent Diffusers',
  url: 'https://www.scentworld.ca/commercial-scent-diffusers',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: models.map((m, i) => ({ '@type': 'ListItem', position: i + 1, url: 'https://www.scentworld.ca/products/' + m.slug, name: m.name }))
  }
}).replace(/</g, '\\u003c') %>
</script>
